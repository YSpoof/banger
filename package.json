{
  "name": "banger",
  "version": "0.0.1",
  "private": true,
  "description": "Search with bangs",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build && cp dist/client/index.html dist/client/404.html",
    "serve": "vite preview",
    "lint": "oxlint src",
    "check": "tsc --noEmit",
    "prepare": "husky",
    "precommit": "lint-staged",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist/client"
  },
  "dependencies": {
    "@solidjs/web": "^2.0.0-rc.6",
    "solid-js": "^2.0.0-rc.6"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@solidjs/diagnostics": "^2.0.0-rc.6",
    "@solidjs/vite-plugin": "^3.0.0-next.38",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.5.2",
    "daisyui": "^5.7.17",
    "eslint-plugin-solid": "~0.18.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "~1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.1.5",
    "vite-plugin-typed-sw": "^1.2.0"
  },
  "lint-staged": {
    "*.{json,ts,tsx,js,css}": "oxfmt"
  },
  "packageManager": "pnpm@12.4.1"
}
